[Unit]
Description=annkescan - flag people, animals and vehicles in archived camera clips
Documentation=file:/opt/annkescan/README.md
Requires=annkescan-storage.service
After=annkescan-storage.service

[Service]
Type=simple
ExecStart=/usr/local/bin/annkescan /etc/default/annkescan
Restart=on-failure
RestartSec=60s
# CPU-heavy: it gets only what nothing else wants
Nice=19
CPUSchedulingPolicy=idle
IOSchedulingClass=idle
MemoryMax=1500M
PrivateTmp=yes
# remembers which screens the archive has been checked against
StateDirectory=annkescan
NoNewPrivileges=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

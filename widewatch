#!/usr/bin/env node
//
// widewatch -- a trial for the wide camera: its stills, live from MQTT, through YOLO26 on the cars zone, a line
// per still, to see that it finds the cars, and what else it takes for one. (YOLOX ran beside it at first, and
// was dropped within the hour for its false positives: a "car" at the zone's left edge, again and again.)
//
// The wide camera has no clips: rtsptomqtt on vader publishes a still every 30 s (<topic>/imagedata, then
// <topic>/metadata with its time), and workshop's mosquitto bridges them in. For each still:
//   - damage: much smaller than the last few (the camera cut its keyframe short): not searched
//   - change in the zone since the last good still: blocks whose brightness moved, once the zone's overall
//     shift (light) is taken out. None, and it is not searched: whatever was there still is. (On the first
//     night, all 18 "cars" were on stills like that: a dark patch at the top of the zone, 0.48 to 0.70.)
//   - the detector over the zone and a margin above it (a car's body over its wheels): 2 searches
//   - vehicles whose bottom centre (the wheels) is white in <masks>/wide-mask-cars.png, at the threshold or
//     better, and with a quarter of the change blocks under them changed: one that came, or moved. One in
//     a still part of the zone is shown as static, and not counted: a parked car, or the patch again.
// and a line:
//
//   time     still          size    zone         | yolo26                     | took
//   15:41:23 20261028144056 1.97MB  change  3/202 | 9.1s car 0.83              | 10.6s  << vehicle
//   15:41:52 20261028144126 1.96MB  same  0/202  | not searched               | 1.1s
//
// <out>/latest.jpg is the last still's zone with the boxes drawn; the stills where something was found are
// kept like that in <out>/<YYYYMMDD>/<time>.jpg, and every line goes to
// <out>/widewatch.jsonl. A summary comes every hour, and at the end (Ctrl-C). The stills themselves are in the
// archiver's snapshots/<YYYYMMDD>/snapshot_<time>.jpg, for 12 days; their time is UTC, the clock's local.
//
// Usage: widewatch [config] [--broker <url>] [--topic <prefix>] [--out <dir>]
//        config: annkedetect's (for masks, models, threshold), default /etc/default/annkedetect;
//        --broker mqtt://localhost, --topic snapshots, --out /opt/storage/disk/widewatch

'use strict';
const fs = require('fs');
const os = require('os');
const path = require('path');
const { spawn } = require('child_process');
const ort = require('onnxruntime-node');
const mqtt = require('mqtt');

// ------------------------------------------------------------------------------------------ config

const args = process.argv.slice(2);
const opt = (name, d) => {
    const i = args.indexOf(`--${name}`);
    return i < 0 || args[i + 1] === undefined ? d : args[i + 1];
};
const CFG_FILE = args.find((a, i) => !a.startsWith('--') && !(i > 0 && args[i - 1].startsWith('--'))) || '/etc/default/annkedetect';
const cfg = {};
try {
    for (const line of fs.readFileSync(CFG_FILE, 'utf8').split('\n')) {
        const m = /^\s*([a-z][a-z0-9-]*)\s*=\s*(.*?)\s*$/.exec(line);
        if (m) cfg[m[1]] = m[2];
    }
} catch (e) {
    console.error(`widewatch: ${CFG_FILE}: ${e.message}`);
    process.exit(1);
}
const MASK = path.join(cfg['masks'] || path.join(__dirname, `annkedetect.${os.hostname()}`), 'wide-mask-cars.png');
const MODELS = cfg['models'] || path.join(__dirname, 'models');
const THRESHOLD = cfg['threshold'] && !isNaN(Number(cfg['threshold'])) ? Number(cfg['threshold']) : 0.4;
const THREADS = cfg['threads'] && !isNaN(Number(cfg['threads'])) ? Number(cfg['threads']) : 2;
const BROKER = opt('broker', 'mqtt://localhost');
const TOPIC = opt('topic', 'snapshots');
const OUT = opt('out', '/opt/storage/disk/widewatch');

const SIZE = 640; // the models' input, square
const OVERLAP = 64; // between tiles, so a car on a seam is whole in one of them
const STEP = SIZE - OVERLAP;
const MARGIN = 128 / 1888; // above the zone, of the frame's height: the far end's cars stand above their wheels
const BLOCK = 32; // change blocks, in pixels of the working size (~64 of the still)
const CHANGE = 15; // a block's brightness change (of 255) that counts, after the zone's own shift
const LIGHT = 0.5; // more than this share of the blocks changed: shown as light (headlights, the IR), searched all the same
const MOVED = 0.25; // of the change blocks under a vehicle, the share that changed for it to have come (or moved)
const DAMAGED = 0.6; // a still under this share of the median size of the last ten is damaged
const VEHICLES = [
    [1, 'bicycle'],
    [2, 'car'],
    [3, 'motorcycle'],
    [5, 'bus'],
    [7, 'truck'],
];
const COLOUR = 'magenta';

// ------------------------------------------------------------------------------------------ util

const pad = (n) => String(n).padStart(2, '0');
const clock = (d = new Date()) => `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
const utcStamp = (d) => d.toISOString().replace(/\D/g, '').slice(0, 14);
const even = (n) => Math.max(2, Math.round(n / 2) * 2);
const secs = (ms) => `${(ms / 1000).toFixed(1)}s`;
const say = (s) => console.log(s);
const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

function run(cmd, argv, input) {
    return new Promise((resolve, reject) => {
        const child = spawn(cmd, argv, { timeout: 120000 });
        const out = [],
            err = [];
        child.stdout.on('data', (d) => out.push(d));
        child.stderr.on('data', (d) => err.push(d));
        child.stdin.on('error', () => {}); // an ffmpeg that gave up early
        child.on('error', reject);
        child.on('close', (code, signal) => {
            if (code === 0) return resolve(Buffer.concat(out));
            reject(new Error(Buffer.concat(err).toString().trim().split('\n').pop() || `${cmd} exited ${code ?? signal}`));
        });
        child.stdin.end(input);
    });
}

// width and height from a JPEG's frame header, without decoding it
function jpegSize(buf) {
    for (let i = 2; i + 9 < buf.length;) {
        if (buf[i] !== 0xff) return null;
        const marker = buf[i + 1];
        if (marker === 0xff) {
            i++;
            continue;
        }
        if (marker >= 0xc0 && marker <= 0xcf && marker !== 0xc4 && marker !== 0xc8 && marker !== 0xcc)
            return { h: buf.readUInt16BE(i + 5), w: buf.readUInt16BE(i + 7) };
        i += 2 + buf.readUInt16BE(i + 2);
    }
    return null;
}

// ------------------------------------------------------------------------------------------ detectors

// YOLO26s (COCO), as in annkedetect

const area = (b) => (b[2] - b[0]) * (b[3] - b[1]);
function iou(a, b) {
    const inter = Math.max(0, Math.min(a[2], b[2]) - Math.max(a[0], b[0])) * Math.max(0, Math.min(a[3], b[3]) - Math.max(a[1], b[1]));
    return inter / (area(a) + area(b) - inter);
}
function nms(dets) {
    const keep = [];
    for (const d of [...dets].sort((a, b) => b.score - a.score)) if (!keep.some((k) => k.name === d.name && iou(k.box, d.box) >= 0.5)) keep.push(d);
    return keep;
}

const MODEL_FILE = 'yolo26s.onnx',
    MODEL_NAME = 'yolo26s (coco, onnx-community)';
let session;

// end to end (no anchors, no suppression needed): per query, 80 class logits, and a box (centre and size as
// fractions of the input); boxes in tile pixels
function decode(outputs) {
    const logits = outputs.logits.data,
        boxes = outputs.pred_boxes.data,
        found = [];
    for (let q = 0; q < outputs.logits.dims[1]; q++)
        for (const [id, name] of VEHICLES) {
            const score = 1 / (1 + Math.exp(-logits[q * 80 + id]));
            if (score <= THRESHOLD) continue;
            const x = boxes[q * 4] * SIZE,
                y = boxes[q * 4 + 1] * SIZE,
                w = boxes[q * 4 + 2] * SIZE,
                h = boxes[q * 4 + 3] * SIZE;
            found.push({ name, score, box: [x - w / 2, y - h / 2, x + w / 2, y + h / 2] });
        }
    return found;
}

// the model's input from a tile of a BGR frame: planar RGB, 0..1, padded with 114 grey
function tensor(frame, W, H, tx, ty) {
    const data = new Float32Array(3 * SIZE * SIZE).fill(114 / 255),
        plane = SIZE * SIZE;
    const tw = Math.min(SIZE, W - tx),
        th = Math.min(SIZE, H - ty);
    for (let y = 0; y < th; y++)
        for (let x = 0, src = ((ty + y) * W + tx) * 3, dst = y * SIZE; x < tw; x++, src += 3, dst++) {
            data[dst] = frame[src + 2] / 255;
            data[plane + dst] = frame[src + 1] / 255;
            data[2 * plane + dst] = frame[src] / 255;
        }
    return new ort.Tensor('float32', data, [1, 3, SIZE, SIZE]);
}

function tileStarts(len) {
    if (len <= SIZE) return [0];
    return Array.from({ length: Math.ceil((len - OVERLAP) / STEP) }, (_, i) => Math.min(i * STEP, len - SIZE));
}

// ------------------------------------------------------------------------------------------ zone

const mask = { w: 0, h: 0, bits: null, zone: null }; // the mask at a quarter size, and the bounds of its white (fractions)

async function loadMask() {
    const [w, h] = (await run('ffprobe', ['-v', 'error', '-show_entries', 'stream=width,height', '-of', 'csv=p=0', MASK]))
        .toString()
        .trim()
        .split(',')
        .map(Number);
    mask.w = Math.round(w / 4);
    mask.h = Math.round(h / 4);
    mask.bits = await run('ffmpeg', ['-v', 'error', '-i', MASK, '-vf', `scale=${mask.w}:${mask.h}:flags=neighbor`, '-f', 'rawvideo', '-pix_fmt', 'gray', '-']);
    const z = { x0: 1, y0: 1, x1: 0, y1: 0 };
    for (let y = 0; y < mask.h; y++)
        for (let x = 0; x < mask.w; x++)
            if (mask.bits[y * mask.w + x] > 127) {
                z.x0 = Math.min(z.x0, x / mask.w);
                z.x1 = Math.max(z.x1, (x + 1) / mask.w);
                z.y0 = Math.min(z.y0, y / mask.h);
                z.y1 = Math.max(z.y1, (y + 1) / mask.h);
            }
    if (z.x1 <= z.x0) throw new Error(`${MASK}: no white in it`);
    mask.zone = z;
    return { w, h };
}

// the box's bottom centre, in a w x h still, white in the mask
function inZone(box, w, h) {
    const x = Math.min(mask.w - 1, Math.max(0, Math.floor((((box[0] + box[2]) / 2) * mask.w) / w)));
    const y = Math.min(mask.h - 1, Math.max(0, Math.floor((box[3] * mask.h) / h)));
    return mask.bits[y * mask.w + x] > 127;
}

// for a still's size: the crop (the zone and the margin above), the working size (one row of tiles), the
// tiles, and the change blocks (those at least a quarter in the zone)
const geometries = new Map();
function geometry(w, h) {
    const key = `${w}x${h}`;
    if (geometries.has(key)) return geometries.get(key);
    const z = mask.zone;
    const cx = even(z.x0 * w),
        cy = even(Math.max(0, (z.y0 - MARGIN) * h));
    const cw = Math.min(even((z.x1 - z.x0) * w), w - cx),
        ch = Math.min(even(z.y1 * h - cy), h - cy);
    const H = SIZE,
        W = even((SIZE * cw) / ch);
    const g = { w, h, cx, cy, cw, ch, W, H, sx: cw / W, sy: ch / H, xs: tileStarts(W), ys: tileStarts(H), blocks: [] };
    for (let by = 0; by + BLOCK <= H; by += BLOCK)
        for (let bx = 0; bx + BLOCK <= W; bx += BLOCK) {
            let inside = 0;
            for (let y = by; y < by + BLOCK; y += 4)
                for (let x = bx; x < bx + BLOCK; x += 4) if (inZone([cx + x * g.sx, 0, cx + x * g.sx, cy + y * g.sy], w, h)) inside++;
            if (inside >= (BLOCK / 4) ** 2 / 4) g.blocks.push([bx, by]);
        }
    geometries.set(key, g);
    return g;
}

// each block's mean brightness
function blockMeans(frame, g) {
    return g.blocks.map(([bx, by]) => {
        let s = 0;
        for (let y = by; y < by + BLOCK; y += 2)
            for (let x = bx; x < bx + BLOCK; x += 2) {
                const i = (y * g.W + x) * 3;
                s += frame[i] * 0.114 + frame[i + 1] * 0.587 + frame[i + 2] * 0.299;
            }
        return s / (BLOCK / 2) ** 2;
    });
}

// whether a vehicle came (or moved): of the change blocks its box (in the still) overlaps, MOVED or more
// changed, and one at least
function movedIn(box, g, changed) {
    let n = 0,
        c = 0;
    g.blocks.forEach(([bx, by], i) => {
        const x = g.cx + bx * g.sx,
            y = g.cy + by * g.sy;
        if (x < box[2] && x + BLOCK * g.sx > box[0] && y < box[3] && y + BLOCK * g.sy > box[1]) {
            n++;
            c += changed[i];
        }
    });
    return c > 0 && c >= MOVED * n;
}

// ------------------------------------------------------------------------------------------ a still

async function detect(frame, g) {
    const t0 = Date.now(),
        found = [];
    for (const ty of g.ys)
        for (const tx of g.xs) {
            const outputs = await session.run({ pixel_values: tensor(frame, g.W, g.H, tx, ty) });
            for (const d of decode(outputs))
                found.push({
                    ...d,
                    box: [g.cx + (d.box[0] + tx) * g.sx, g.cy + (d.box[1] + ty) * g.sy, g.cx + (d.box[2] + tx) * g.sx, g.cy + (d.box[3] + ty) * g.sy],
                });
        }
    const kept = nms(found).filter((d) => inZone(d.box, g.w, g.h));
    return { ms: Date.now() - t0, found: kept.map((d) => ({ class: d.name, score: Math.round(d.score * 100) / 100, box: d.box.map(Math.round) })) };
}

// the zone at the working size, with the boxes, as a JPEG at <file> (and at <copy>, when given)
async function draw(frame, g, found, file, copy) {
    const boxes = found.map((d) => {
        const x = Math.round((d.box[0] - g.cx) / g.sx),
            y = Math.round((d.box[1] - g.cy) / g.sy);
        const w = Math.max(4, Math.round((d.box[2] - d.box[0]) / g.sx)),
            h = Math.max(4, Math.round((d.box[3] - d.box[1]) / g.sy));
        return `drawbox=x=${x}:y=${y}:w=${w}:h=${h}:color=${COLOUR}:t=3`;
    });
    const jpg = await run(
        'ffmpeg',
        ['-v', 'error', '-f', 'rawvideo', '-pix_fmt', 'bgr24', '-s', `${g.W}x${g.H}`, '-i', '-']
            .concat(boxes.length ? ['-vf', boxes.join(',')] : [])
            .concat(['-frames:v', '1', '-c:v', 'mjpeg', '-q:v', '4', '-f', 'image2pipe', '-']),
        frame
    );
    fs.writeFileSync(`${file}.part`, jpg);
    fs.renameSync(`${file}.part`, file);
    if (copy) {
        fs.mkdirSync(path.dirname(copy), { recursive: true });
        fs.writeFileSync(copy, jpg);
    }
}

const sizes = []; // the last ten stills' sizes
let ref = null; // the last good still's block means

async function handle(job) {
    for (let i = 0; i < 20 && !job.stamp; i++) await sleep(100); // its metadata, with its time, comes just after it
    const t0 = Date.now(),
        stamp = job.stamp || utcStamp(new Date(job.arrived));
    const r = { arrived: new Date(job.arrived).toISOString(), stamp, size: job.jpg.length, skipped: job.skipped };
    const median = sizes.length >= 3 ? [...sizes].sort((a, b) => a - b)[sizes.length >> 1] : 0;
    r.damaged = median > 0 && job.jpg.length < DAMAGED * median;
    sizes.push(job.jpg.length); // damaged too: at dusk the stills shrink, and the median has to follow
    if (sizes.length > 10) sizes.shift();
    const dims = jpegSize(job.jpg);
    if (!dims) r.damaged = true;
    if (r.damaged) {
        r.verdict = 'damaged';
        return r;
    }
    const g = geometry(dims.w, dims.h);
    const frame = await run(
        'ffmpeg',
        ['-v', 'error', '-i', '-', '-vf', `crop=${g.cw}:${g.ch}:${g.cx}:${g.cy},scale=${g.W}:${g.H}:flags=area`, '-f', 'rawvideo', '-pix_fmt', 'bgr24', '-'],
        job.jpg
    );
    if (frame.length !== g.W * g.H * 3) throw new Error(`decoded ${frame.length} bytes, not ${g.W * g.H * 3}`);
    r.decodeMs = Date.now() - t0;
    const means = blockMeans(frame, g);
    let changed = null;
    if (ref && ref.length === means.length) {
        const d = means.map((v, i) => v - ref[i]),
            shift = [...d].sort((a, b) => a - b)[d.length >> 1],
            dev = d.map((v) => Math.abs(v - shift));
        changed = dev.map((v) => v > CHANGE);
        r.change = { max: Math.round(Math.max(...dev)), blocks: changed.filter(Boolean).length, of: means.length };
        r.verdict = r.change.blocks === 0 ? 'same' : r.change.blocks > LIGHT * means.length ? 'light' : 'change';
    } else r.verdict = 'first';
    ref = means;
    if (r.verdict !== 'same') {
        r.yolo26 = await detect(frame, g);
        if (changed) for (const f of r.yolo26.found) f.moved = movedIn(f.box, g, changed);
    }
    r.tookMs = Date.now() - job.arrived;
    const found = r.yolo26?.found || [];
    await draw(frame, g, found, path.join(OUT, 'latest.jpg'), found.length ? path.join(OUT, stamp.slice(0, 8), `${stamp}.jpg`) : null);
    return r;
}

// a vehicle that came or moved (or, on the first still, any)
const flagged = (r) => !!r.yolo26?.found.some((f) => f.moved !== false);

// ------------------------------------------------------------------------------------------ the line

const shown = (d) =>
    !d
        ? 'not searched'
        : `${secs(d.ms)} ${
              d.found.length
                  ? d.found
                        .slice(0, 3)
                        .map((f) => `${f.class} ${f.score.toFixed(2)}${f.moved === false ? ' static' : ''}`)
                        .join(', ') + (d.found.length > 3 ? ` +${d.found.length - 3}` : '')
                  : '-'
          }`;

function line(r) {
    const zone = r.change ? `${r.verdict} ${String(r.change.blocks).padStart(2)}/${r.change.of}` : r.verdict;
    const tag = flagged(r) ? '  << vehicle' : '';
    return (
        `${clock()} ${r.stamp} ${(r.size / 1e6).toFixed(2)}MB  ${zone.padEnd(12)} | ${shown(r.yolo26).padEnd(26)} | ` +
        `${r.tookMs !== undefined ? secs(r.tookMs) : '-'}${r.skipped ? ` (${r.skipped} skipped before)` : ''}${tag}`
    );
}
const HEADER = `time     still          size    zone         | ${'yolo26'.padEnd(26)} | took`;

// a summary each hour (of the clock), and at the end
const newStats = () => ({ from: new Date(), stills: 0, damaged: 0, skipped: 0, errors: 0, done: 0, took: 0, max: 0, searched: 0, vehicle: 0 });
let hour = newStats(),
    total = newStats();
function count(r) {
    for (const s of [hour, total]) {
        s.stills++;
        s.skipped += r.skipped || 0;
        if (r.error) s.errors++;
        else if (r.damaged) s.damaged++;
        else {
            s.done++;
            s.took += r.tookMs;
            s.max = Math.max(s.max, r.tookMs);
            s.searched += !!r.yolo26;
            s.vehicle += flagged(r);
        }
    }
}
function summary(s, what) {
    const each = s.done ? `; ${secs(s.took / s.done)} each (most ${secs(s.max)})` : '';
    return `-- ${what}: ${s.stills} stills (${s.damaged} damaged, ${s.skipped} skipped, ${s.errors} failed), ${s.searched} searched${each}; ${s.vehicle} with a vehicle`;
}
function hourly() {
    const now = new Date();
    if (now.getHours() === hour.from.getHours() && now - hour.from < 3600000) return;
    if (hour.stills) say(summary(hour, `${clock(hour.from).slice(0, 5)} to ${clock(now).slice(0, 5)}`));
    hour = newStats();
}

// ------------------------------------------------------------------------------------------ main

(async () => {
    const { w, h } = await loadMask();
    session = await ort.InferenceSession.create(path.join(MODELS, MODEL_FILE), { intraOpNumThreads: THREADS, interOpNumThreads: 1, logSeverityLevel: 3 });
    fs.mkdirSync(OUT, { recursive: true });
    const log = fs.createWriteStream(path.join(OUT, 'widewatch.jsonl'), { flags: 'a' });
    const g = geometry(w, h),
        z = mask.zone;
    say(
        `widewatch: ${BROKER} ${TOPIC}/imagedata; zone ${path.basename(MASK)} ${Math.round((z.x1 - z.x0) * w)}x${Math.round((z.y1 - z.y0) * h)} at ` +
            `${Math.round(z.x0 * w)},${Math.round(z.y0 * h)} of ${w}x${h}, ${g.cy < Math.round(z.y0 * h) ? `${Math.round(z.y0 * h) - g.cy} px above it, ` : ''}` +
            `as ${g.W}x${g.H}: ${g.xs.length * g.ys.length} searches; ${g.blocks.length} change blocks`
    );
    say(`widewatch: ${MODEL_NAME}, ${THREADS} threads, threshold ${THRESHOLD}; kept stills, latest.jpg and widewatch.jsonl in ${OUT}`);

    let busy = false,
        pending = null,
        latest = null,
        skipped = 0,
        lines = 0,
        online = null;
    async function pump() {
        if (busy || !pending) return;
        busy = true;
        const job = pending;
        pending = null;
        job.skipped = skipped;
        skipped = 0;
        let r;
        try {
            r = await handle(job);
        } catch (e) {
            r = {
                arrived: new Date(job.arrived).toISOString(),
                stamp: job.stamp || utcStamp(new Date(job.arrived)),
                size: job.jpg.length,
                skipped: job.skipped,
                error: e.message,
            };
        }
        hourly();
        if (lines++ % 40 === 0) say(HEADER);
        say(r.error ? `${clock()} ${r.stamp} ${(r.size / 1e6).toFixed(2)}MB  FAILED: ${r.error}` : line(r));
        log.write(JSON.stringify(r) + '\n');
        count(r);
        busy = false;
        pump();
    }

    const client = mqtt.connect(BROKER, { clientId: `widewatch-${os.hostname()}-${process.pid}`, reconnectPeriod: 5000 });
    client.on('connect', () => {
        if (online !== true) say(`${clock()} mqtt: connected, waiting for stills`);
        online = true;
        client.subscribe([`${TOPIC}/imagedata`, `${TOPIC}/metadata`]);
    });
    client.on('offline', () => {
        if (online !== false) say(`${clock()} mqtt: offline, retrying`);
        online = false;
    });
    client.on('error', (e) => say(`${clock()} mqtt: ${e.message}`));
    client.on('message', (topic, payload) => {
        if (topic.endsWith('/imagedata')) {
            if (pending) skipped++; // still busy with the one before: only the newest waits
            pending = latest = { jpg: Buffer.from(payload), arrived: Date.now(), stamp: null };
            pump();
        } else if (topic.endsWith('/metadata'))
            try {
                const m = JSON.parse(payload.toString()); // {"time": "<YYYYMMDDHHMMSS>", "size": <bytes>}, just after its still
                if (latest && !latest.stamp && m.size === latest.jpg.length) latest.stamp = String(m.time);
            } catch {
                /* not ours */
            }
    });
    const stop = () => {
        say(summary(total, `since ${total.from.toLocaleString('sv-SE').slice(0, 16)}`));
        client.end(true);
        process.exit(0);
    };
    process.on('SIGINT', stop);
    process.on('SIGTERM', stop);
})().catch((e) => {
    console.error(`widewatch: ${e.message}`);
    process.exit(1);
});

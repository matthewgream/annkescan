#!/usr/bin/env node
//
// annkescan -- flag the people, animals and vehicles seen in the camera archive's clips, for annkeserv.
//
// A long-running worker at idle priority. It looks for the clips annkepull archived
// (<archive>/<camera>/<YYYYMMDD>/recording_<...>.mp4) that have no result beside them yet, and works through
// them newest first: a new clip is flagged soon after it arrives, and older ones are done when there is
// nothing new. For each clip it decodes the keyframes (one every 8 s on side, 3.8 s on front), runs an object
// detector over each (trained on COCO, through ONNX Runtime: YOLOX-S, or YOLO26s for clips recorded from
// yolo26-from on), and writes beside the clip
//
//     recording_<...>.json   {"seen": {"people": 0.85, "animals": 0.47}, "detections": [...], "ignored": [...]}
//     recording_<...>.jpg    only when something was seen: the keyframe with the best detection, boxes drawn
//
// The .json goes last, so its presence means the clip is done -- the archive is the state, as for annkepull.
// Remove a clip's .json to have it done again (after changing masks or settings, say).
//
// What counts as seen:
//   - classes are reported by group -- people; animals (bird cat dog horse sheep cow); vehicles (bicycle car
//     motorcycle bus truck) -- as at these distances the species is often wrong (a cat as "sheep") while the
//     group is right. A tractor comes out as a truck.
//   - only where its bottom centre (feet, wheels) is white in the camera's mask, when it has one:
//     <masks>/<camera>-mask.png for every group, or <camera>-mask-<group>[-and-<group>].png ("cars" is
//     vehicles). Only the part of the frame that the masks cover is decoded and searched.
//   - not a vehicle in the same place in every keyframe: something parked, or a lid the model takes for a
//     car. The cameras record on motion, so what set the clip off moves.
//   - small things need detail: tiles-<camera>=2 searches 640 px tiles of a frame scaled to two tiles wide
//     (four times the pixels per object, about twice the time). At one tile the side camera's dog and cat
//     were missed.
//   - not a known false positive. Copy a clip's result file (recording_<...>.json) into <screens>/ and each
//     detection in it becomes one: a detection of the same group on the same camera in the same place (its
//     box's centre inside the false positive's box, at no more than twice or half its size) is ignored --
//     side's tank lid, a "car" in one keyframe of a clip but never in all of them, which the rule above
//     needs. Results already written are checked again whenever the folder changes, so a file dropped in
//     (or taken out) also corrects the past. The folder is watched, so that is within seconds.
//
// Once a day (report-at, by when the morning's pull is done), a report of the clips done since the last one goes
// to MQTT (mqtt-server, <mqtt-topic>/<YYYYMMDD>): per camera and in all, the clips, their length, and how many had
// each group seen, with people_or_animals for mqtt-watchdog to notify on.
//
// Config: /etc/default/annkescan (key=value).
// Usage: annkescan [config]                                      work through the archive, then keep watching it
//        annkescan [config] [--model <name>] --test <clip> ...  print what each clip would get, writing nothing
//                                                                  (with the detector its time gets, or <name>'s)

'use strict';
const fs = require('fs');
const path = require('path');
const { spawn } = require('child_process');
const ort = require('onnxruntime-node');

// ------------------------------------------------------------------------------------------ config

const args = process.argv.slice(2);
const testAt = args.indexOf('--test');
const opts = testAt < 0 ? args : args.slice(0, testAt);
const modelAt = opts.indexOf('--model');
const TEST_MODEL = modelAt < 0 ? undefined : opts[modelAt + 1];
const CFG_FILE = opts.find((a, i) => !a.startsWith('--') && (modelAt < 0 || i !== modelAt + 1)) || '/etc/default/annkescan';
const TEST_CLIPS = testAt < 0 ? undefined : args.slice(testAt + 1);
const cfg = {};
try {
    for (const line of fs.readFileSync(CFG_FILE, 'utf8').split('\n')) {
        const m = /^\s*([a-z][a-z0-9-]*)\s*=\s*(.*?)\s*$/.exec(line);
        if (m) cfg[m[1]] = m[2];
    }
} catch (e) {
    console.error(`annkescan: ${CFG_FILE}: ${e.message}`);
    process.exit(1);
}
const num = (k, d) => (cfg[k] !== undefined && cfg[k] !== '' && !isNaN(Number(cfg[k])) ? Number(cfg[k]) : d);

const GROUPS = ['people', 'animals', 'vehicles'];
const CAMERAS = Object.entries(cfg) // camera-<name>=<groups to flag>, tiles-<name>=<n>
    .filter(([k, v]) => k.startsWith('camera-') && v)
    .map(([k, v]) => {
        const name = k.slice('camera-'.length);
        return { name, groups: v.split(',').map((g) => g.trim()), tiles: Math.max(1, Math.round(num(`tiles-${name}`, 1))), masks: null, maskStamp: '' };
    });
const ARCHIVE = cfg['archive'] || '/opt/storage/camera';
const MASKS = cfg['masks'] || ''; // directory of <camera>-mask*.png; empty: no masks
const MODELS = cfg['models'] || path.join(__dirname, 'models'); // directory of the detectors' .onnx files
const YOLO26_FROM = cfg['yolo26-from'] || ''; // clips recorded from then on (YYYYMMDDHHMMSS, as in their names) get YOLO26
const THRESHOLD = num('threshold', 0.4); // score a detection needs to count
const DAYS = num('days', 0); // only clips from the last <n> days; 0: the whole archive
const RESCAN = num('rescan', 3600); // seconds between looks for new clips (annkepull brings them every 6 hours)
const THREADS = num('threads', 2);
const SCREENS = cfg['screens'] || ''; // directory of result files whose detections are false positives; empty: none
// where the screens last applied to the archive are remembered, so a restart does not check it all again
const SCREENS_APPLIED = process.env.STATE_DIRECTORY ? path.join(process.env.STATE_DIRECTORY, 'screens.applied') : '';
const MQTT_SERVER = cfg['mqtt-server'] || ''; // where the report goes; empty: none
const MQTT_TOPIC = cfg['mqtt-topic'] || 'camera/detect'; // the report's topic is <topic>/<YYYYMMDD>
const REPORT_AT = cfg['report-at'] ?? '06:00'; // the time of day (HH:MM, local) it goes; empty: whenever the clips are done
// the report under way and the day the last one went, so a restart loses neither
const REPORT_STATE = process.env.STATE_DIRECTORY ? path.join(process.env.STATE_DIRECTORY, 'report.json') : '';

for (const cam of CAMERAS)
    for (const g of cam.groups)
        if (!GROUPS.includes(g)) {
            console.error(`annkescan: ${CFG_FILE}: camera-${cam.name}: unknown group "${g}" (${GROUPS.join(', ')})`);
            process.exit(1);
        }
if (REPORT_AT && !/^([01]?\d|2[0-3]):[0-5]\d$/.test(REPORT_AT)) {
    console.error(`annkescan: ${CFG_FILE}: report-at: "${REPORT_AT}" is not HH:MM`);
    process.exit(1);
}
if (!CAMERAS.length && !TEST_CLIPS) {
    console.error(`annkescan: ${CFG_FILE}: no camera-<name>=<groups> entries`);
    process.exit(1);
}
if (YOLO26_FROM && !/^\d{14}$/.test(YOLO26_FROM)) {
    console.error(`annkescan: ${CFG_FILE}: yolo26-from: "${YOLO26_FROM}" is not YYYYMMDDHHMMSS`);
    process.exit(1);
}

// The detectors: the model file, its input, and how its output is decoded. YOLOX-S came first. YOLO26s took
// over for clips recorded from yolo26-from on (2026-10-28): in a bake-off on 57 clips it had none of YOLOX's
// false positives (a log as a "dog", a downpipe as a "person", heads at the frame's edge as "birds", side's
// lid and block pallets as vehicles) but missed side's tractor at night. Clips from before -- the backlog --
// stay with YOLOX, so the switch happens once, at a time, not part way through the archive.
const DETECTORS = {
    yolox: { file: 'yolox_s.onnx', name: 'yolox-s (coco, 2022nov)', input: 'images', rgb: false, decode: decodeYolox },
    yolo26: { file: 'yolo26s.onnx', name: 'yolo26s (coco, onnx-community)', input: 'pixel_values', rgb: true, decode: decodeYolo26 },
};
if (TEST_MODEL && !DETECTORS[TEST_MODEL]) {
    console.error(`annkescan: --model: unknown "${TEST_MODEL}" (${Object.keys(DETECTORS).join(', ')})`);
    process.exit(1);
}
const detectorFor = (stamp) => (YOLO26_FROM && stamp >= YOLO26_FROM ? 'yolo26' : 'yolox');

const VERSION = 1;
const SIZE = 640; // the model's input, square
const OVERLAP = 64; // between tiles, so a thing on a seam is whole in one of them
const STEP = SIZE - OVERLAP;
// COCO ids worth a flag outdoors: [id, class, group]
const CLASSES = [
    [0, 'person', 'people'],
    [1, 'bicycle', 'vehicles'],
    [2, 'car', 'vehicles'],
    [3, 'motorcycle', 'vehicles'],
    [5, 'bus', 'vehicles'],
    [7, 'truck', 'vehicles'],
    [14, 'bird', 'animals'],
    [15, 'cat', 'animals'],
    [16, 'dog', 'animals'],
    [17, 'horse', 'animals'],
    [18, 'sheep', 'animals'],
    [19, 'cow', 'animals'],
];
const COLOURS = { people: 'red', animals: 'yellow', vehicles: 'cyan' };
const RE_DAY = /^\d{8}$/;
const RE_CLIP = /^recording_(\d{14})(?:_\d+)?\.mp4$/;

// ------------------------------------------------------------------------------------------ util

const log = (...a) => console.log(...a); // journald stamps it
const even = (n) => Math.max(2, Math.round(n / 2) * 2);
const pad = (n) => String(n).padStart(2, '0');
const dayOf = (d) => `${d.getFullYear()}${pad(d.getMonth() + 1)}${pad(d.getDate())}`;
const round = (n, places) => Math.round(n * 10 ** places) / 10 ** places;

function run(cmd, argv, binary = false, input = undefined) {
    return new Promise((resolve, reject) => {
        const child = spawn(cmd, argv, { timeout: 600000 });
        const out = [],
            err = [];
        child.stdout.on('data', (d) => out.push(d));
        child.stderr.on('data', (d) => err.push(d));
        child.stdin.on('error', () => {}); // one that gave up before reading it
        child.on('error', reject);
        child.on('close', (code, signal) => {
            if (code === 0) return resolve(binary ? Buffer.concat(out) : Buffer.concat(out).toString());
            reject(new Error(Buffer.concat(err).toString().trim().split('\n').pop() || `${cmd} exited ${code ?? signal}`));
        });
        child.stdin.end(input);
    });
}

function writeAtomic(file, data) {
    fs.writeFileSync(`${file}.part`, data);
    fs.renameSync(`${file}.part`, file);
}

// ------------------------------------------------------------------------------------------ masks

const MASK_WIDTH = 960; // plenty for looking up a point

// {group: {w, h, bits}} from the camera's mask files, or null when it has none; re-read when one changes
async function masksFor(cam) {
    if (!MASKS) return null;
    let names;
    // the camera's general mask first, so a group's own mask (<camera>-mask-<group>.png) overrides it for that
    // group: by name alone it would sort first, '-' before '.', and be overridden
    const general = `${cam.name}-mask.png`;
    try {
        names = (await fs.promises.readdir(MASKS))
            .filter((n) => n.startsWith(`${cam.name}-mask`) && n.endsWith('.png'))
            .sort((a, b) => (b === general) - (a === general) || a.localeCompare(b));
    } catch {
        return null;
    }
    const stamp = (await Promise.all(names.map(async (n) => `${n}@${(await fs.promises.stat(path.join(MASKS, n))).mtimeMs}`))).join(' ');
    if (stamp === cam.maskStamp) return cam.masks;
    const masks = {};
    for (const n of names) {
        const file = path.join(MASKS, n),
            tail = n.slice(`${cam.name}-mask`.length, -'.png'.length).replace(/^-/, '');
        const groups = tail ? tail.split('-and-').map((g) => (g === 'cars' ? 'vehicles' : g)) : GROUPS;
        const [w, h] = (await run('ffprobe', ['-v', 'error', '-show_entries', 'stream=width,height', '-of', 'csv=p=0', file])).trim().split(',').map(Number);
        const mh = Math.round((h * MASK_WIDTH) / w);
        const bits = await run(
            'ffmpeg',
            ['-v', 'error', '-i', file, '-vf', `scale=${MASK_WIDTH}:${mh}:flags=neighbor`, '-f', 'rawvideo', '-pix_fmt', 'gray', '-'],
            true
        );
        for (const g of groups)
            if (GROUPS.includes(g)) masks[g] = { w: MASK_WIDTH, h: mh, bits };
            else log(`${cam.name}: ${n}: unknown group "${g}", ignored`);
    }
    cam.masks = names.length ? masks : null;
    cam.maskStamp = stamp;
    if (names.length) log(`${cam.name}: masks ${names.join(', ')}`);
    return cam.masks;
}

// the part of the frame (fractions) that the masks of the camera's groups cover: all that is searched
function masksBounds(masks, groups) {
    const b = { x0: 1, y0: 1, x1: 0, y1: 0 };
    for (const g of groups) {
        const m = masks?.[g];
        if (!m) continue;
        for (let y = 0; y < m.h; y++)
            for (let x = 0; x < m.w; x++)
                if (m.bits[y * m.w + x] > 127) {
                    ((b.x0 = Math.min(b.x0, x / m.w)), (b.x1 = Math.max(b.x1, (x + 1) / m.w)));
                    ((b.y0 = Math.min(b.y0, y / m.h)), (b.y1 = Math.max(b.y1, (y + 1) / m.h)));
                }
    }
    return masks && b.x1 > b.x0 ? b : { x0: 0, y0: 0, x1: 1, y1: 1 };
}

function inZone(masks, group, box, w, h) {
    if (!masks) return true;
    const m = masks[group];
    if (!m) return false;
    const x = Math.min(m.w - 1, Math.max(0, Math.floor((((box[0] + box[2]) / 2) * m.w) / w)));
    const y = Math.min(m.h - 1, Math.max(0, Math.floor((box[3] * m.h) / h)));
    return m.bits[y * m.w + x] > 127;
}

// ------------------------------------------------------------------------------------------ detector

// each detector's session, made when a clip first needs it
const sessions = {};
const sessionFor = (name) =>
    (sessions[name] ??= ort.InferenceSession.create(path.join(MODELS, DETECTORS[name].file), {
        intraOpNumThreads: THREADS,
        interOpNumThreads: 1,
        logSeverityLevel: 3,
    }));

// YOLOX's output is per anchor of a 80x80, 40x40 and 20x20 grid: cx, cy, w, h (in grid cells), objectness, 80 class scores
const ANCHORS = [];
for (const s of [8, 16, 32]) for (let y = 0; y < SIZE / s; y++) for (let x = 0; x < SIZE / s; x++) ANCHORS.push([x, y, s]);

const area = (b) => (b[2] - b[0]) * (b[3] - b[1]);
function iou(a, b) {
    const inter = Math.max(0, Math.min(a[2], b[2]) - Math.max(a[0], b[0])) * Math.max(0, Math.min(a[3], b[3]) - Math.max(a[1], b[1]));
    return inter / (area(a) + area(b) - inter);
}
// best first, dropping what overlaps a better box of the same class
function nms(dets) {
    const keep = [];
    for (const d of [...dets].sort((a, b) => b.score - a.score)) if (!keep.some((k) => k.name === d.name && iou(k.box, d.box) >= 0.5)) keep.push(d);
    return keep;
}

function decodeYolox(outputs, classes) {
    const out = outputs.output.data,
        found = [];
    for (const [id, name, group] of classes) {
        const candidates = [];
        for (let i = 0; i < ANCHORS.length; i++) {
            const o = i * 85,
                score = out[o + 4] * out[o + 5 + id];
            if (score <= THRESHOLD) continue;
            const [gx, gy, s] = ANCHORS[i];
            const x = (out[o] + gx) * s,
                y = (out[o + 1] + gy) * s,
                w = Math.exp(out[o + 2]) * s,
                h = Math.exp(out[o + 3]) * s;
            candidates.push({ name, group, score, box: [x - w / 2, y - h / 2, x + w / 2, y + h / 2] });
        }
        found.push(...nms(candidates));
    }
    return found;
}

// YOLO26's output is end to end (no anchors, no suppression needed): per query, 80 class logits, and a box
// (centre and size as fractions of the input)
function decodeYolo26(outputs, classes) {
    const logits = outputs.logits.data,
        boxes = outputs.pred_boxes.data,
        found = [];
    for (let q = 0; q < outputs.logits.dims[1]; q++)
        for (const [id, name, group] of classes) {
            const score = 1 / (1 + Math.exp(-logits[q * 80 + id]));
            if (score <= THRESHOLD) continue;
            const x = boxes[q * 4] * SIZE,
                y = boxes[q * 4 + 1] * SIZE,
                w = boxes[q * 4 + 2] * SIZE,
                h = boxes[q * 4 + 3] * SIZE;
            found.push({ name, group, score, box: [x - w / 2, y - h / 2, x + w / 2, y + h / 2] });
        }
    return found;
}

// one model input from a tile of a BGR frame, planar, padded with 114 grey: BGR 0..255 for YOLOX, RGB 0..1 for YOLO26
function tensor(frame, W, H, tx, ty, rgb) {
    const f = rgb ? 1 / 255 : 1,
        data = new Float32Array(3 * SIZE * SIZE).fill(114 * f),
        plane = SIZE * SIZE,
        [c0, c2] = rgb ? [2, 0] : [0, 2];
    const tw = Math.min(SIZE, W - tx),
        th = Math.min(SIZE, H - ty);
    for (let y = 0; y < th; y++)
        for (let x = 0, src = ((ty + y) * W + tx) * 3, dst = y * SIZE; x < tw; x++, src += 3, dst++) {
            data[dst] = frame[src + c0] * f;
            data[plane + dst] = frame[src + 1] * f;
            data[2 * plane + dst] = frame[src + c2] * f;
        }
    return new ort.Tensor('float32', data, [1, 3, SIZE, SIZE]);
}

// starts of SIZE-long tiles covering len, overlapping by OVERLAP; one (padded) when len fits
function tileStarts(len) {
    if (len <= SIZE) return [0];
    return Array.from({ length: Math.ceil((len - OVERLAP) / STEP) }, (_, i) => Math.min(i * STEP, len - SIZE));
}

// ------------------------------------------------------------------------------------------ clips

// size, length, and keyframe times in seconds from the start, from the packets (without decoding)
async function probe(clip) {
    const j = JSON.parse(
        await run('ffprobe', [
            '-v',
            'error',
            '-select_streams',
            'v:0',
            '-show_entries',
            'stream=width,height:format=start_time,duration:packet=pts_time,flags',
            '-of',
            'json',
            clip,
        ])
    );
    const start = Number(j.format?.start_time) || 0;
    const keys = (j.packets || [])
        .filter((p) => p.flags?.startsWith('K'))
        .map((p) => Number(p.pts_time) - start)
        .sort((a, b) => a - b);
    return { w: j.streams[0].width, h: j.streams[0].height, duration: Number(j.format?.duration) || 0, keys };
}

// the keyframes, cropped to the bounds and scaled to <tiles> tiles across, as raw BGR
async function keyframes(clip, w, h, bounds, tiles) {
    const cx = even(bounds.x0 * w),
        cy = even(bounds.y0 * h);
    const cw = Math.min(even((bounds.x1 - bounds.x0) * w), w - cx),
        ch = Math.min(even((bounds.y1 - bounds.y0) * h), h - cy);
    // (side's mask makes this 684 high, so a second row of tiles: shrinking to one row halved the time but
    // took the dog in the trial clip from 0.73 to 0.52, and time is what this box has)
    const W = tiles * STEP + OVERLAP,
        H = even((ch * W) / cw);
    const raw = await run(
        'ffmpeg',
        [
            '-v',
            'error',
            '-skip_frame',
            'nokey',
            '-i',
            clip,
            '-vsync',
            '0',
            '-vf',
            `crop=${cw}:${ch}:${cx}:${cy},scale=${W}:${H}:flags=area`,
            '-f',
            'rawvideo',
            '-pix_fmt',
            'bgr24',
            '-',
        ],
        true
    );
    const bytes = W * H * 3;
    return {
        frames: Array.from({ length: Math.floor(raw.length / bytes) }, (_, i) => raw.subarray(i * bytes, (i + 1) * bytes)),
        W,
        H,
        cx,
        cy,
        sx: cw / W,
        sy: ch / H,
    };
}

async function detectClip(cam, clip, detector) {
    const det = DETECTORS[detector],
        session = await sessionFor(detector);
    const masks = await masksFor(cam);
    const classes = CLASSES.filter(([, , g]) => cam.groups.includes(g));
    const { w, h, duration, keys } = await probe(clip);
    const kf = await keyframes(clip, w, h, masksBounds(masks, cam.groups), cam.tiles);
    const xs = tileStarts(kf.W),
        ys = tileStarts(kf.H);
    const frames = []; // per keyframe, detections in the clip's pixels
    for (const frame of kf.frames) {
        const dets = [];
        for (const ty of ys)
            for (const tx of xs) {
                const outputs = await session.run({ [det.input]: tensor(frame, kf.W, kf.H, tx, ty, det.rgb) });
                for (const d of det.decode(outputs, classes))
                    dets.push({
                        ...d,
                        box: [
                            kf.cx + (d.box[0] + tx) * kf.sx,
                            kf.cy + (d.box[1] + ty) * kf.sy,
                            kf.cx + (d.box[2] + tx) * kf.sx,
                            kf.cy + (d.box[3] + ty) * kf.sy,
                        ],
                    });
            }
        frames.push(nms(dets)); // the same thing found in two overlapping tiles
    }
    const detections = [],
        ignored = [],
        seen = {};
    frames.forEach((dets, k) => {
        for (const d of dets) {
            const entry = {
                keyframe: k,
                t: keys[k] !== undefined ? round(keys[k], 1) : null,
                group: d.group,
                class: d.name,
                score: round(d.score, 2),
                box: d.box.map(Math.round),
            };
            const screen = screenFor(cam.name, d.group, entry.box);
            if (!inZone(masks, d.group, d.box, w, h)) ignored.push({ ...entry, why: 'zone' });
            else if (screen) ignored.push({ ...entry, why: 'screen', screen: screen.file });
            else if (
                d.group === 'vehicles' &&
                frames.length > 1 &&
                frames.every((other) => other.some((o) => o.group === 'vehicles' && iou(o.box, d.box) >= 0.6))
            )
                ignored.push({ ...entry, why: 'static' });
            else {
                detections.push(entry);
                seen[d.group] = Math.max(seen[d.group] || 0, entry.score);
            }
        }
    });
    return {
        w,
        h,
        result: {
            version: VERSION,
            model: det.name,
            camera: cam.name,
            tiles: cam.tiles,
            duration: round(duration, 1),
            keyframes: frames.length,
            seen,
            detections,
            ignored,
        },
    };
}

// the keyframe with the best detection, 640 wide, with that keyframe's detections boxed in their group's colour
async function thumbnail(clip, w, h, detections, file) {
    const best = detections.reduce((a, b) => (b.score > a.score ? b : a));
    const tw = 640,
        th = even((h * tw) / w),
        s = tw / w;
    const boxes = detections
        .filter((d) => d.keyframe === best.keyframe)
        .map(
            (d) =>
                `drawbox=x=${Math.round(d.box[0] * s)}:y=${Math.round(d.box[1] * s)}:w=${Math.max(2, Math.round((d.box[2] - d.box[0]) * s))}:h=${Math.max(2, Math.round((d.box[3] - d.box[1]) * s))}:color=${COLOURS[d.group]}:t=2`
        );
    await run('ffmpeg', [
        '-v',
        'error',
        '-y',
        '-skip_frame',
        'nokey',
        '-i',
        clip,
        '-vsync',
        '0',
        '-vf',
        [`select=eq(n\\,${best.keyframe})`, `scale=${tw}:${th}`, ...boxes].join(','),
        '-frames:v',
        '1',
        '-c:v',
        'mjpeg',
        '-q:v',
        '4',
        '-update',
        '1',
        '-f',
        'image2',
        `${file}.part`,
    ]);
    fs.renameSync(`${file}.part`, file);
}

const failed = new Set(); // clips that failed: left until a restart rather than retried every pass

async function doClip({ cam, clip, stamp }) {
    const json = clip.replace(/\.mp4$/, '.json'),
        jpg = clip.replace(/\.mp4$/, '.jpg'),
        name = path.relative(path.join(ARCHIVE, cam.name), clip),
        detector = detectorFor(stamp);
    const t0 = Date.now();
    try {
        const { w, h, result } = await detectClip(cam, clip, detector);
        if (result.detections.length) await thumbnail(clip, w, h, result.detections, jpg);
        else fs.rmSync(jpg, { force: true });
        writeAtomic(json, JSON.stringify({ ...result, processed: new Date().toISOString() }) + '\n');
        const seen = Object.entries(result.seen)
            .map(([g, s]) => `${g} ${s.toFixed(2)}`)
            .join(', ');
        log(`${cam.name}: ${name}: ${detector}, ${result.keyframes} keyframes, ${Math.round((Date.now() - t0) / 1000)}s${seen ? ' -- ' + seen : ''}`);
        tally(cam, stamp, result);
        return !!seen;
    } catch (e) {
        failed.add(clip);
        log(`${cam.name}: ${name}: FAILED: ${e.message}`);
        tally(cam, stamp, null);
        return false;
    }
}

// ------------------------------------------------------------------------------------------ report

// Once a day, at REPORT_AT, what was done since the last time goes to MQTT, <topic>/<YYYYMMDD>: per camera and
// in all, the clips, their length, and how many had each group seen. annkepull brings clips every 6 hours, so
// the report waits for a time of day rather than going each time they are done: one a day, after the
// morning's pull (04:00-04:30 and some minutes; its clips done by ~05:15). The wait between looks ends at that
// time, so there is one more look for clips first; if clips are still being done, it goes when they are.
// What it has so far is kept in STATE_DIRECTORY, so a restart in the day does not lose it.
// mqtt-watchdog's alerts are states (a field holding a value) rather than events, so a report with people or
// animals in it is sent twice, people_or_animals true and then false, as zigbee's test button does: one
// notification each time, and nothing left held.
let report = null, // since the last one
    reported = ''; // the day the last one went (YYYYMMDD)
const newCount = () => ({ clips: 0, seconds: 0, failed: 0, ...Object.fromEntries(GROUPS.map((g) => [g, 0])) });

// REPORT_AT on the day of d
function reportTime(d) {
    const [h, m] = REPORT_AT.split(':').map(Number);
    return new Date(d.getFullYear(), d.getMonth(), d.getDate(), h, m);
}
const reportDue = (now = new Date()) => !REPORT_AT || (now >= reportTime(now) && reported !== dayOf(now));
// ms to the next report time
function untilReport(now = new Date()) {
    if (!REPORT_AT) return Infinity;
    const t = reportTime(now);
    return (t > now ? t : reportTime(new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1))) - now;
}

function loadReport() {
    try {
        ({ reported, report } = JSON.parse(fs.readFileSync(REPORT_STATE, 'utf8')));
    } catch {
        // none kept: the first report goes at the next report time, not at once
        if (REPORT_AT && new Date() >= reportTime(new Date())) reported = dayOf(new Date());
    }
}
function saveReport() {
    if (REPORT_STATE) writeAtomic(REPORT_STATE, JSON.stringify({ reported, report }) + '\n');
}

function tally(cam, stamp, result) {
    if (!MQTT_SERVER) return;
    report ??= { from: stamp, to: stamp, total: newCount(), cameras: {} };
    if (stamp < report.from) report.from = stamp;
    if (stamp > report.to) report.to = stamp;
    for (const c of [report.total, (report.cameras[cam.name] ??= newCount())])
        if (!result) c.failed++;
        else {
            c.clips++;
            c.seconds += result.duration || 0;
            for (const g of Object.keys(result.seen)) c[g]++;
        }
    saveReport();
}

// "1h23m", "12m", "40s"
const hours = (s) => {
    const r = Math.round(s),
        m = Math.round(r / 60);
    return r < 60 ? `${r}s` : m < 60 ? `${m}m` : `${Math.floor(m / 60)}h${pad(m % 60)}m`;
};
// "46 clips, 1h23m: people 2, animals 1"
const counted = (c, groups) =>
    `${c.clips} clip${c.clips === 1 ? '' : 's'}, ${hours(c.seconds)}: ${
        groups
            .filter((g) => c[g])
            .map((g) => `${g} ${c[g]}`)
            .join(', ') || 'nothing seen'
    }${c.failed ? ` (${c.failed} failed)` : ''}`;

// what was done since the last report, if anything; either way the day's is done
async function sendReport() {
    const r = report;
    report = null;
    reported = dayOf(new Date());
    saveReport();
    if (r) await publishReport(r);
}

async function publishReport(r) {
    const cams = CAMERAS.filter((c) => r.cameras[c.name]);
    for (const c of [r.total, ...Object.values(r.cameras)]) c.seconds = Math.round(c.seconds);
    const message = {
        day: dayOf(new Date()),
        from: r.from,
        to: r.to,
        ...r.total,
        cameras: r.cameras,
        summary: [
            `all ${counted(r.total, [...new Set(cams.flatMap((c) => c.groups))])}`,
            ...cams.map((c) => `${c.name} ${counted(r.cameras[c.name], c.groups)}`),
        ].join('\n'),
        people_or_animals: r.total.people + r.total.animals > 0,
    };
    const topic = `${MQTT_TOPIC}/${message.day}`;
    const lines = [JSON.stringify(message)].concat(message.people_or_animals ? [JSON.stringify({ ...message, people_or_animals: false })] : []);
    try {
        const url = new URL(MQTT_SERVER.includes('://') ? MQTT_SERVER : `mqtt://${MQTT_SERVER}`);
        const tls = url.protocol === 'mqtts:';
        await run(
            'mosquitto_pub',
            ['-h', url.hostname, '-p', url.port || (tls ? '8883' : '1883'), ...(tls ? ['--capath', '/etc/ssl/certs'] : []), '-t', topic, '-q', '1', '-l'],
            false,
            lines.join('\n') + '\n'
        );
        log(`report: ${topic}: ${message.summary.replace(/\n/g, '; ')}`);
    } catch (e) {
        log(`report: ${topic}: publish to ${MQTT_SERVER} FAILED: ${e.message}`);
    }
}

// ------------------------------------------------------------------------------------------ screens

// Known false positives: each detection in each result file in SCREENS, for that result's camera
let screens = [],
    screensStamp = null;

// The same place: the box's centre inside the false positive's box, at no more than twice or half its size.
// Not overlap (IoU): on a small box a few pixels' shift halves it -- side's turquoise thing at the back,
// 98x29 one day and 131x32 the next, overlapped by 0.39.
function samePlace(s, box) {
    const cx = (box[0] + box[2]) / 2,
        cy = (box[1] + box[3]) / 2,
        ratio = area(box) / area(s);
    return cx >= s[0] && cx <= s[2] && cy >= s[1] && cy <= s[3] && ratio <= 2 && ratio >= 0.5;
}
const screenFor = (camera, group, box) => screens.find((s) => s.camera === camera && s.group === group && samePlace(s.box, box));

// re-read SCREENS when its files have changed (or at the first call); says whether they had
async function loadScreens() {
    if (!SCREENS) return false;
    let names = [];
    try {
        names = (await fs.promises.readdir(SCREENS)).filter((n) => n.endsWith('.json')).sort();
    } catch {
        /* no folder: no screens */
    }
    const stamps = await Promise.all(
        names.map((n) =>
            fs.promises.stat(path.join(SCREENS, n)).then(
                (s) => `${n}@${s.mtimeMs}`,
                () => `${n}@gone`
            )
        )
    );
    const stamp = stamps.join(' ');
    if (stamp === screensStamp) return false;
    const list = [];
    for (const n of names)
        try {
            const r = JSON.parse(await fs.promises.readFile(path.join(SCREENS, n), 'utf8'));
            for (const d of r.detections || []) if (r.camera && d.group && d.box) list.push({ camera: r.camera, group: d.group, box: d.box, file: n });
        } catch (e) {
            log(`screens: ${n}: ${e.message}, ignored`);
        }
    screens = list;
    screensStamp = stamp;
    log(`screens: ${list.length} false positives from ${names.length} files in ${SCREENS}`);
    return true;
}

const byKeyframe = (a, b) => a.keyframe - b.keyframe || b.score - a.score;
const listKey = (list) => JSON.stringify(list.map((d) => [d.keyframe, d.group, d.box, d.why, d.screen]).sort());
// what a thumbnail of these detections shows: the best one's keyframe, and that keyframe's boxes
function thumbKey(dets) {
    if (!dets.length) return '';
    const best = dets.reduce((a, b) => (b.score > a.score ? b : a));
    return listKey(dets.filter((d) => d.keyframe === best.keyframe));
}

// one result, checked against the screens as they are now, without detecting again; says whether it changed
async function rescreenResult(cam, json) {
    const clip = json.replace(/\.json$/, '.mp4'),
        jpg = json.replace(/\.json$/, '.jpg'),
        name = path.relative(path.join(ARCHIVE, cam.name), clip);
    try {
        const r = JSON.parse(await fs.promises.readFile(json, 'utf8'));
        if (!Array.isArray(r.detections)) return false;
        const candidates = [...r.detections, ...(r.ignored || []).filter((d) => d.why === 'screen').map(({ why, screen, ...d }) => d)];
        const detections = [],
            ignored = (r.ignored || []).filter((d) => d.why !== 'screen');
        for (const d of candidates) {
            const screen = screenFor(cam.name, d.group, d.box);
            if (screen) ignored.push({ ...d, why: 'screen', screen: screen.file });
            else detections.push(d);
        }
        if (listKey(detections) === listKey(r.detections) && listKey(ignored) === listKey(r.ignored || [])) return false;
        detections.sort(byKeyframe);
        const seen = {};
        for (const d of detections) seen[d.group] = Math.max(seen[d.group] || 0, d.score);
        if (!detections.length) fs.rmSync(jpg, { force: true });
        else if (thumbKey(detections) !== thumbKey(r.detections) || !fs.existsSync(jpg)) {
            const { w, h } = await probe(clip);
            await thumbnail(clip, w, h, detections, jpg);
        }
        writeAtomic(json, JSON.stringify({ ...r, seen, detections, ignored, screened: new Date().toISOString() }) + '\n');
        const now = Object.entries(seen)
            .map(([g, s]) => `${g} ${s.toFixed(2)}`)
            .join(', ');
        log(`${cam.name}: ${name}: rescreened -- ${now || 'nothing seen'}`);
        return true;
    } catch (e) {
        log(`${cam.name}: ${name}: rescreen FAILED: ${e.message}`);
        return false;
    }
}

// the screens, applied to every result already written (when they have changed since that was last done)
async function rescreen() {
    let applied = '';
    try {
        applied = SCREENS_APPLIED ? fs.readFileSync(SCREENS_APPLIED, 'utf8') : '';
    } catch {
        /* never applied */
    }
    if (applied === screensStamp) return;
    const t0 = Date.now();
    let checked = 0,
        changed = 0;
    for (const cam of CAMERAS) {
        const root = path.join(ARCHIVE, cam.name);
        let days = [];
        try {
            days = (await fs.promises.readdir(root)).filter((d) => RE_DAY.test(d));
        } catch (e) {
            log(`${cam.name}: ${e.message}`);
            continue;
        }
        for (const day of days)
            for (const n of await fs.promises.readdir(path.join(root, day))) {
                if (!n.endsWith('.json') || !RE_CLIP.test(n.replace(/\.json$/, '.mp4'))) continue;
                checked++;
                if (await rescreenResult(cam, path.join(root, day, n))) changed++;
            }
    }
    if (SCREENS_APPLIED) writeAtomic(SCREENS_APPLIED, screensStamp);
    log(`screens: ${checked} results checked, ${changed} changed, in ${Math.round((Date.now() - t0) / 1000)}s`);
}

// The folder is watched (inotify) rather than listed before every clip: a change marks it to be read again,
// and wakes the loop if it is waiting, so a file dropped in takes effect within seconds even when there is
// nothing to do. Events are let settle for a moment first: a copy is a create and then writes.
const SETTLE = 2000;
let screensDirty = true, // read at the first call either way
    watching = false,
    wake = null; // ends the wait for the next look, when there is one
function watchScreens() {
    if (!SCREENS) return;
    let settle = null;
    try {
        fs.watch(SCREENS, () => {
            clearTimeout(settle);
            settle = setTimeout(() => {
                screensDirty = true;
                if (wake) wake();
            }, SETTLE);
        }).on('error', (e) => {
            watching = false;
            log(`screens: watching ${SCREENS} stopped (${e.message}): read before each clip instead`);
        });
        watching = true;
    } catch (e) {
        log(`screens: cannot watch ${SCREENS} (${e.message}): read before each clip instead`);
    }
}

async function screensChanged() {
    if (watching && !screensDirty) return;
    screensDirty = false;
    try {
        if (await loadScreens()) await rescreen();
    } catch (e) {
        log(`screens: ${e.message}`);
    }
}

// wait <ms>, or until the screens change
const idle = (ms) =>
    new Promise((resolve) => {
        const t = setTimeout(resolve, ms);
        wake = () => {
            clearTimeout(t);
            resolve();
        };
    }).finally(() => (wake = null));

// ------------------------------------------------------------------------------------------ scan

// clips without a result, newest first; a leftover .part (an interrupted write) is removed on the way
async function scan() {
    const since = DAYS ? dayOf(new Date(Date.now() - DAYS * 86400000)) : '';
    const todo = [];
    for (const cam of CAMERAS) {
        const root = path.join(ARCHIVE, cam.name);
        let days;
        try {
            days = (await fs.promises.readdir(root)).filter((d) => RE_DAY.test(d) && d >= since);
        } catch (e) {
            log(`${cam.name}: ${e.message}`);
            continue;
        }
        for (const day of days) {
            const names = await fs.promises.readdir(path.join(root, day)),
                have = new Set(names);
            for (const n of names) {
                if (/\.(json|jpg)\.part$/.test(n)) fs.rmSync(path.join(root, day, n), { force: true });
                const m = RE_CLIP.exec(n);
                if (!m || have.has(n.replace(/\.mp4$/, '.json'))) continue;
                const clip = path.join(root, day, n);
                if (!failed.has(clip)) todo.push({ cam, clip, stamp: m[1] });
            }
        }
    }
    return todo.sort((a, b) => b.stamp.localeCompare(a.stamp));
}

// ------------------------------------------------------------------------------------------ main

(async () => {
    if (TEST_CLIPS) {
        await loadScreens();
        for (const clip of TEST_CLIPS) {
            const camName = path.basename(path.dirname(path.dirname(path.resolve(clip))));
            const cam = CAMERAS.find((c) => c.name === camName) || { name: camName, groups: GROUPS, tiles: 1, masks: null, maskStamp: '' };
            const detector = TEST_MODEL || detectorFor(RE_CLIP.exec(path.basename(clip))?.[1] || '');
            const t0 = Date.now(),
                { result } = await detectClip(cam, clip, detector);
            console.log(JSON.stringify({ clip, secs: Math.round((Date.now() - t0) / 1000), ...result }));
        }
        return;
    }
    log(
        `annkescan: ${CAMERAS.map((c) => `${c.name}=${c.groups.join('+')}${c.tiles > 1 ? `/tiles ${c.tiles}` : ''}`).join(' ')} in ${ARCHIVE}` +
            `${DAYS ? `, last ${DAYS} days` : ''}, threshold ${THRESHOLD}, masks ${MASKS || 'none'}, screens ${SCREENS || 'none'}` +
            `, detector yolox${YOLO26_FROM ? `, yolo26 for clips from ${YOLO26_FROM}` : ''}` +
            `, reports ${MQTT_SERVER ? `to ${MQTT_SERVER} ${MQTT_TOPIC}/<day>${REPORT_AT ? ` at ${REPORT_AT}` : ''}` : 'none'}`
    );
    if (MQTT_SERVER) loadReport();
    watchScreens();
    for (;;) {
        await screensChanged();
        let todo = [];
        try {
            todo = await scan();
        } catch (e) {
            log(`annkescan: scan: ${e.message}`);
        }
        if (!todo.length) {
            if (MQTT_SERVER && reportDue()) await sendReport();
            await idle(Math.min(RESCAN * 1000, untilReport() + 1000));
            continue;
        }
        log(`annkescan: ${todo.length} clips to do, ${todo[0].stamp.slice(0, 8)} back to ${todo.at(-1).stamp.slice(0, 8)}`);
        // look again for new clips every RESCAN seconds, so they go ahead of the backlog
        const until = Date.now() + RESCAN * 1000,
            t0 = Date.now();
        let done = 0,
            flagged = 0;
        for (const item of todo) {
            await screensChanged(); // a file dropped in takes effect before the next clip
            if (await doClip(item)) flagged++;
            done++;
            if (Date.now() > until) break;
        }
        log(`annkescan: ${done} done (${flagged} with something seen) in ${Math.round((Date.now() - t0) / 60000)}m`);
    }
})().catch((e) => {
    console.error(`annkescan: ${e.message}`);
    process.exit(1);
});
